# =============================================================================
# ApplySwipe environment configuration
# Copy to `.env` and fill in the values you need. Everything marked OPTIONAL has
# a safe default: the app boots and the job feed works without any job provider
# credentials (Greenhouse/Lever boards are public; Adzuna needs a key).
# =============================================================================

# --- Core ---------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/applyswipe"
AUTH_SECRET="applyswipe-super-secret-jwt-key-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local JSON data store used by the development build (and by the test suite):
# APPLYSWIPE_DB_FILE="data/applyswipe.json"

# --- OAuth (OPTIONAL) ---------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI providers (OPTIONAL) --------------------------------------------------
# The deterministic matching engine and the grounded local engine work without
# any key; adding one only upgrades the wording of AI-generated documents.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# --- Caching / storage / email / payments (OPTIONAL) --------------------------
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="applyswipe-documents"
RESEND_API_KEY=""
STRIPE_SECRET_KEY=""
PAYSTACK_SECRET_KEY=""

# =============================================================================
# Job aggregation
# =============================================================================

# --- Provider credentials -----------------------------------------------------
# Adzuna requires an app id + key (https://developer.adzuna.com). Keys are read
# server-side only and are never exposed to the client or to API responses.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="gb"
# Optional overrides (defaults shown) - useful for self-hosted proxies in tests.
# ADZUNA_BASE_URL="https://api.adzuna.com/v1/api/jobs"
# GREENHOUSE_BASE_URL="https://boards-api.greenhouse.io"
# LEVER_BASE_URL="https://api.lever.co"

# Default Adzuna search used when no Adzuna profile is configured in Job Sources.
ADZUNA_DEFAULT_QUERY="software engineer"
ADZUNA_DEFAULT_LOCATION=""
ADZUNA_MAX_PAGES_PER_SYNC="2"

# --- HTTP client --------------------------------------------------------------
JOBS_HTTP_TIMEOUT_MS="12000"
JOBS_HTTP_RETRIES="2"

# --- Freshness & sync cadence -------------------------------------------------
# A job is deactivated (never deleted) when its provider stops returning it for
# longer than the freshness window.
JOB_FRESHNESS_ADZUNA_HOURS="48"
JOB_FRESHNESS_GREENHOUSE_HOURS="72"
JOB_FRESHNESS_LEVER_HOURS="72"
JOB_SYNC_INTERVAL_ADZUNA_MIN="120"
JOB_SYNC_INTERVAL_GREENHOUSE_MIN="360"
JOB_SYNC_INTERVAL_LEVER_MIN="360"
JOB_SYNC_LOCK_TTL_MS="900000"
JOB_FEED_HORIZON_DAYS="45"

# --- Matching -----------------------------------------------------------------
# Stage 1 weights (must add up to 100). Override individual keys only.
MATCH_WEIGHTS_JSON='{"skills":35,"experience":20,"location":15,"employment":10,"salary":10,"seniority":10}'
JOB_MATCH_KEEP_PER_USER="400"
# Stage 2: bounded AI re-ranking of the top slice only (never the full feed).
JOB_AI_RERANK_ENABLED="true"
JOB_AI_RERANK_TOP="20"
JOB_AI_RERANK_CACHE_HOURS="12"
JOB_AI_RERANK_MAX_PER_RUN="25"

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_FEED_BURST="30"
RATE_LIMIT_FEED_PER_MINUTE="60"
RATE_LIMIT_SEARCH_BURST="30"
RATE_LIMIT_SEARCH_PER_MINUTE="60"

# --- Background workers -------------------------------------------------------
# In-process scheduler (src/instrumentation.ts). Runs sync/expiration/matching
# ticks inside the Next.js server - fine for a single node or local dev. Set to
# "false" when you run `npm run workers` as a separate process or use cron.
JOBS_SCHEDULER_ENABLED="true"
JOBS_SCHEDULER_TICK_MS="900000"
JOBS_EXPIRATION_INTERVAL_MS="43200000"
JOBS_MATCHING_INTERVAL_MS="21600000"
JOBS_SCHEDULER_BOOT_DELAY_MS="15000"

# --- Cron / external schedulers ----------------------------------------------
# POST /api/cron/jobs/{sync|expire|match} with `Authorization: Bearer $CRON_SECRET`.
# In production these endpoints return 503 when CRON_SECRET is missing.
CRON_SECRET=""
# Local development escape hatch: allow unprotected cron calls outside production.
JOBS_ALLOW_UNPROTECTED_CRON="false"

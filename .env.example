# ApplySwipe Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/applyswipe"

# Authentication Session Secret
AUTH_SECRET="applyswipe-super-secret-jwt-key-change-in-production"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Providers (Optional - Local Grounded Engine used if keys omitted)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Background Jobs & Caching
REDIS_URL="redis://localhost:6379"

# S3-Compatible Storage
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="applyswipe-documents"

# Email Delivery
RESEND_API_KEY=""

# Payment Gateways
STRIPE_SECRET_KEY=""
PAYSTACK_SECRET_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
